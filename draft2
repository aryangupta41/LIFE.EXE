class Screen {
public:
    explicit Screen(Context& c) : ctx_(c) {}
    virtual ~Screen() = default;
    virtual void run() = 0;

protected:
    Context& ctx_;
};

class MenuScreen : public Screen {
public:
    using Screen::Screen;

    void run() override {
        while (true) {
            std::cout << "CHOOSE ONE OPTION:\n\n1. WHAT IS THIS GAME\n2. HOW TO PLAY\n3. SETTINGS\n4. START\n";
            int c = ui::askChoice(1, 4);

            if (c == 1) {
                page(R"T(WHAT IS THIS GAME?

This is a basic choice-based game set in India.
You are born, you make choices, and life happens.
It is nothing serious. Just fun.)T");
            } else if (c == 2) {
                page(R"T(HOW TO PLAY

Just type the number of the choice you want.
Like in real life, you have the freedom of choice.
(Whether the choice matters is another question.))T");
            } else if (c == 3) {
                settingsPage();
            } else {
                return;
            }
        }
    }

private:
    void page(const std::string& text) {
        std::cout << text << "\n";
        ui::waitEnter();
    }

    void settingsPage() {
        std::cout << "SETTINGS\n\nShow spicy facts and stats?\n\n1. YES (spicy ON)\n2. NO  (spicy OFF)\n";
        int c = ui::askChoice(1, 2);
        ctx_.settings.setSpicy(c == 1);
        ctx_.files.saveSettings(ctx_.settings);
        std::cout << "\n" << (c == 1 ? "Spicy is ON." : "Spicy is OFF.") << "\n";
        ui::waitEnter();
    }
};

class BirthScreen : public Screen {
public:
    using Screen::Screen;

    void run() override {
        Player& p = ctx_.player;
        std::cout << "BIRTH\n\nCHOOSE ONE OPTION:\n\n1. MALE\n2. FEMALE\n";
        int c = ui::askChoice(1, 2);

        if (c == 1) {
            p.setGender(Gender::Male);
            std::mt19937 rng{std::random_device{}()};
            int sisters = std::uniform_int_distribution<int>(2, 4)(rng);

            std::cout << "Congratulations, you're a boy!\n\n"
                      << "Your entire family is overjoyed. You have " << sisters
                      << " older sisters, but don't worry,\n"
                      << "they barely count. Your parents finally got what they wanted:\n"
                      << "someone to carry the family name, inherit the property,\n"
                      << "and prove the previous attempts weren't in vain.\n";

            if (ctx_.settings.spicy())
                std::cout << "\nSPICE: In India, around 35% of families with two daughters\n"
                             "and no sons wanted another child, compared with 9% of\n"
                             "families with two sons and no daughters. [NFHS-5]\n";
        } else {
            p.setGender(Gender::Female);
            std::cout << "Sorry, you spawned in the wrong family.\n\n"
                         "Your existence became a problem the moment\n"
                         "they discovered you weren't a boy.\n";

            if (ctx_.settings.spicy())
                std::cout << "\nSPICE: An estimated 9 million girls went missing due to\n"
                             "sex-selective abortions between 2000 and 2019.\n";

            ui::waitEnter("(Press Enter to try again)");

            std::cout << "Congratulations! This time you were born into a good family,\n"
                         "and they all love you.\n";
        }

        p.setStats(100, 0, 0);
        p.setStage(0);
        std::cout << "\nAGE 0: You are born.\n";
        p.showStats();
        ctx_.files.saveGame(p);
        ctx_.files.logChoice("Age 0", p, c == 1 ? "MALE" : "FEMALE");
        ui::waitEnter();
    }
};

class StoryScreen : public Screen {
public:
    StoryScreen(Context& c, int age) : Screen(c), age_(age) {}

    void run() override {
        Player& p = ctx_.player;
        Scene sc = (age_ == 10) ? story::age10(p.gender()) : story::age13(p.gender(), p.path());

        std::cout << "AGE " << age_ << "\n\n";

        if (!sc.preface.empty()) {
            std::cout << sc.preface << "\n";
            ui::waitEnter();
            std::cout << "AGE " << age_ << "\n\n";
        }

        std::cout << sc.text << "\n\n";

        for (size_t i = 0; i < sc.choices.size(); ++i)
            std::cout << (i + 1) << ". " << sc.choices[i].label << "\n";

        int pick = ui::askChoice(1, static_cast<int>(sc.choices.size()));
        const Choice& ch = sc.choices[pick - 1];

        std::cout << ch.result << "\n";

        p.setStats(ch.happiness, ch.parents, ch.log);

        if (age_ == 10) {
            p.setPath(pick - 1);
            p.setStage(1);
        } else {
            p.setPersonality(ch.personality + ": " + ch.personalityDesc);
            p.setStage(2);
        }

        p.showStats();
        ctx_.files.saveGame(p);
        ctx_.files.logChoice("Age " + std::to_string(age_), p, ch.label);
        ui::waitEnter();
    }

private:
    int age_;
};

class EndingScreen : public Screen {
public:
    using Screen::Screen;

    void run() override {
        std::cout << "PERSONALITY: " << ctx_.player.personality() << "\n";
        ctx_.player.showStats();
        std::cout << "\nTo be continued...\n";
        ctx_.files.clearSave();
        ui::waitEnter("(Press Enter to exit)");
    }
};

class Game {
public:
    Game() {
        ctx_.files.loadSettings(ctx_.settings);
    }

    void play() {
        MenuScreen(ctx_).run();

        bool resumed = tryResume();
        std::vector<std::unique_ptr<Screen>> flow;

        if (!resumed) {
            ctx_.player = Player();
            flow.push_back(std::make_unique<BirthScreen>(ctx_));
        }

        if (ctx_.player.stage() < 1 || !resumed)
            flow.push_back(std::make_unique<StoryScreen>(ctx_, 10));

        if (ctx_.player.stage() < 2 || !resumed)
            flow.push_back(std::make_unique<StoryScreen>(ctx_, 13));

        flow.push_back(std::make_unique<EndingScreen>(ctx_));

        for (auto& s : flow)
            s->run();
    }

private:
    bool tryResume() {
        if (!ctx_.files.loadGame(ctx_.player)) return false;

        std::cout << "A saved game was found.\n\n1. CONTINUE\n2. NEW GAME\n";

        if (ui::askChoice(1, 2) == 1) return true;

        ctx_.files.clearSave();
        return false;
    }

    Context ctx_;
};

int main() {
    try {
        Game game;
        game.play();
    } catch (const std::exception& e) {
        std::cout << "\nGame closed (" << e.what() << ").\n";
    }

    return 0;
}
