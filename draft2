class InvalidChoiceException : public std::runtime_error {
public:
    explicit InvalidChoiceException(const std::string& msg) : std::runtime_error(msg) {}
};

namespace ui {

void clear() {
#ifdef _WIN32
    std::system("cls");
#else
    std::system("clear");
#endif
}

void waitEnter(const std::string& prompt = "(Press Enter to continue)") {
    std::cout << "\n" << prompt;
    std::string s;
    if (!std::getline(std::cin, s)) throw std::runtime_error("input closed");
}

int readChoice(int lo, int hi) {
    std::cout << "\n> ";
    std::string line;
    if (!std::getline(std::cin, line)) throw std::runtime_error("input closed");

    size_t b = line.find_first_not_of(" \t\r\n");
    size_t e = line.find_last_not_of(" \t\r\n");
    if (b == std::string::npos) throw InvalidChoiceException("Please type a number.");
    line = line.substr(b, e - b + 1);

    for (char ch : line)
        if (ch < '0' || ch > '9')
            throw InvalidChoiceException("'" + line + "' is not a valid number. Please type " +
                                         std::to_string(lo) + " to " + std::to_string(hi) + ".");
    if (line.size() > 6) throw InvalidChoiceException("That number is too big.");

    int n = std::stoi(line);
    if (n < lo || n > hi)
        throw InvalidChoiceException("Please choose between " + std::to_string(lo) + " and " +
                                     std::to_string(hi) + ".");
    return n;
}

int askChoice(int lo, int hi) {
    while (true) {
        try {
            return readChoice(lo, hi);
        } catch (const InvalidChoiceException& e) {
            std::cout << e.what() << "\n";
        }
    }
}

}

enum class Gender { None, Male, Female };

class Player {
public:
    Gender gender() const { return gender_; }
    int happiness() const { return happiness_; }
    int parents() const { return parents_; }
    int log() const { return log_; }
    const std::string& personality() const { return personality_; }
    int stage() const { return stage_; }
    int path() const { return path_; }

    void setGender(Gender g) { gender_ = g; }
    void setStats(int h, int p, int l) { happiness_ = h; parents_ = p; log_ = l; }
    void setPersonality(const std::string& s) { personality_ = s; }
    void setStage(int s) { stage_ = s; }
    void setPath(int p) { path_ = p; }

    std::string genderName() const {
        return gender_ == Gender::Male ? "Boy" : gender_ == Gender::Female ? "Girl" : "Unknown";
    }

    void showStats() const {
        std::cout << "\n[ Happiness: " << happiness_ << " | Parents ki khushi: " << parents_
                  << " | Log kya sochenge: " << log_ << " ]\n";
    }

private:
    Gender gender_ = Gender::None;
    int happiness_ = 100;
    int parents_ = 0;
    int log_ = 0;
    std::string personality_ = "NONE";
    int stage_ = 0;
    int path_ = 0;
};

class Settings {
public:
    bool spicy() const { return spicy_; }
    void setSpicy(bool v) { spicy_ = v; }

private:
    bool spicy_ = true;
};

class FileManager {
public:
    static constexpr const char* SAVE = "savegame.txt";
    static constexpr const char* SETTINGS = "settings.txt";
    static constexpr const char* HISTORY = "history.txt";

    void saveSettings(const Settings& s) const {
        std::ofstream f(SETTINGS);
        if (!f) {
            warn(SETTINGS);
            return;
        }
        f << "spicy=" << (s.spicy() ? 1 : 0) << "\n";
    }

    void loadSettings(Settings& s) const {
        auto kv = readKeyValues(SETTINGS);
        if (kv.count("spicy")) s.setSpicy(kv["spicy"] != "0");
    }

    void saveGame(const Player& p) const {
        std::ofstream f(SAVE);
        if (!f) {
            warn(SAVE);
            return;
        }
        f << "gender=" << (p.gender() == Gender::Male ? "MALE" : "FEMALE") << "\n"
          << "happiness=" << p.happiness() << "\n"
          << "parents=" << p.parents() << "\n"
          << "log=" << p.log() << "\n"
          << "personality=" << p.personality() << "\n"
          << "stage=" << p.stage() << "\n"
          << "path=" << p.path() << "\n";
    }

    bool loadGame(Player& out) const {
        auto kv = readKeyValues(SAVE);
        if (kv.empty()) return false;
        try {
            if (!kv.count("gender") || !kv.count("happiness") || !kv.count("parents") ||
                !kv.count("log") || !kv.count("stage") || !kv.count("path"))
                return false;

            Player p;
            if (kv["gender"] == "MALE") p.setGender(Gender::Male);
            else if (kv["gender"] == "FEMALE") p.setGender(Gender::Female);
            else return false;

            p.setStats(std::stoi(kv["happiness"]), std::stoi(kv["parents"]), std::stoi(kv["log"]));
            p.setStage(std::stoi(kv["stage"]));
            p.setPath(std::stoi(kv["path"]));

            if (p.stage() < 0 || p.stage() > 1 || (p.path() != 0 && p.path() != 1))
                return false;

            if (kv.count("personality")) p.setPersonality(kv["personality"]);
            out = p;
            return true;
        } catch (const std::exception&) {
            return false;
        }
    }

    bool hasSave() const {
        std::ifstream f(SAVE);
        return f.good();
    }

    void clearSave() const {
        std::remove(SAVE);
    }

    void logChoice(const std::string& age, const Player& p, const std::string& label) const {
        std::ofstream f(HISTORY, std::ios::app);
        if (!f) return;

        f << age << " | " << p.genderName() << " | " << label << " | Happiness " << p.happiness()
          << ", Parents " << p.parents() << ", Log " << p.log() << "\n";
    }

private:
    static void warn(const char* name) {
        std::cout << "(Warning: could not write " << name << ")\n";
    }

    static std::map<std::string, std::string> readKeyValues(const char* path) {
        std::map<std::string, std::string> kv;
        std::ifstream f(path);
        std::string line;

        while (std::getline(f, line)) {
            size_t eq = line.find('=');
            if (eq == std::string::npos) continue;

            std::string v = line.substr(eq + 1);
            while (!v.empty() && (v.back() == '\r' || v.back() == ' '))
                v.pop_back();

            kv[line.substr(0, eq)] = v;
        }

        return kv;
    }
};

struct Context {
    Player player;
    Settings settings;
    FileManager files;
};

struct Choice {
    std::string label;
    std::string result;
    int happiness, parents, log;
    std::string personality;
    std::string personalityDesc;
};

struct Scene {
    std::string preface;
    std::string text;
    std::vector<Choice> choices;
};

